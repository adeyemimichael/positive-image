# Positive Image Schools - Environment Variables Template
# Copy this file to .env for local development
# For production, set these in Vercel Dashboard → Settings → Environment Variables

# Paystack API Keys (Get from https://dashboard.paystack.com/#/settings/developers)
# Use TEST keys for development, LIVE keys for production
PAYSTACK_SECRET_KEY=sk_test_c8e5ee36c4e94479aada7f11f1708a0c03def283
VITE_PAYSTACK_PUBLIC_KEY=pk_test_d92f0b7317fce078078c0ff7c47c985ac2c6b42b

# Application URL
# For local development, use your Vite dev server URL
# For production, Vercel automatically sets VERCEL_URL
VITE_APP_URL=http://localhost:5173

# Vercel URL (automatically set by Vercel in production)
# Do not set this manually - Vercel provides it
# VERCEL_URL=your-app.vercel.app

# Supabase Configuration (Get from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api)
# These are safe to expose in the frontend (for anon key only)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (KEEP SECRET - Server-side only!)
# DO NOT expose this in frontend code - use only in API routes
# This key bypasses Row Level Security
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin Password Hash (Optional - for enhanced security)
# Generate hash using the simpleHash function in src/config/admin.ts
# If not set, defaults to hash of 'adminadmin'
VITE_ADMIN_PASSWORD_HASH=

# IMPORTANT SECURITY NOTES:
# 1. NEVER commit the actual .env file to git (it's in .gitignore)
# 2. REGENERATE Paystack keys if this repository was ever public
# 3. Use LIVE keys (sk_live_...) only in production
# 4. Set environment variables in Vercel Dashboard for production
# 5. Change admin password from default 'adminadmin' for production
# 6. SUPABASE_SERVICE_ROLE_KEY should NEVER be in frontend code
# 7. Only use SUPABASE_SERVICE_ROLE_KEY in API routes (api/ folder)
